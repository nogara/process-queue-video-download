# Copie para config.env e preencha. Depois: chmod 600 config.env
#
# ---- Obrigatórios ----
#
# api_id / api_hash: crie um app em https://my.telegram.org
#   Login > API development tools > preencha qualquer nome/URL > pegue os valores.
API_ID=
API_HASH=

# Alvo do envio: username do bot/canal que recebe o link (ex: @meu_bot).
TARGET=

# Pasta da fila onde você larga os *.txt. ~ é expandido.
QUEUE_DIR=~/queue/video-downloader

# ---- Opcionais (têm default; descomente para mudar) ----
#
# Nome do arquivo de sessão do Telegram (gera <nome>.session no dir do projeto).
#SESSION_NAME=queue
#
# Subpastas de destino dentro de QUEUE_DIR.
#PROCESSED_SUBDIR=processed
#FAILED_SUBDIR=failed
#
# Lockfile usado pelo cron (via flock) para evitar execuções sobrepostas.
#LOCK_FILE=/tmp/vdq.lock
